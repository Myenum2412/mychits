# Database configuration (PostgreSQL)
# Format: postgresql+psycopg2://user:password@host:port/database_name
# or postgresql://user:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chits_db

# Application Settings
APP_NAME="Chit Fund Management API"
DEBUG=True
API_V1_STR=/api/v1

# CORS - Allowed Frontend Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
